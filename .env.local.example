# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Phase 2 onwards) ---
# From Supabase dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server-only, bypasses RLS. Used by scripts and API routes.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (Phase 4 onwards) ---
# From Cloudflare dashboard > R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL for the bucket (custom domain or *.r2.dev). Used to build image src.
R2_PUBLIC_URL=

# --- Replicate (Phase 5 onwards) ---
# From replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
