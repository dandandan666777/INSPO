# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Supabase (Phase 2 onwards) ---
# From Supabase dashboard > Project Settings > API
SUPABASE_URL=
# Server-only "secret" key. Bypasses RLS. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Cloudflare R2 (Phase 4 onwards) ---
# From Cloudflare dashboard > R2 > Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL for the bucket (custom domain or *.r2.dev). Used to build image src.
R2_PUBLIC_URL=

# --- Replicate (Phase 5 onwards) ---
# From replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
